SARA_BOT_TOKEN=your_sara_bot_token
AMIR_BOT_TOKEN=your_amir_bot_token
LALEH_BOT_TOKEN=your_laleh_bot_token
NAVID_BOT_TOKEN=your_navid_bot_token
NEDA_BOT_TOKEN=your_neda_bot_token

# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/petmagix
