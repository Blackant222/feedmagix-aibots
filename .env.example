# ===========================================
# AI APIs CONFIGURATION
# ===========================================
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google API Key for advanced services (Docs, Drive, Search, Gemini AI)
GOOGLE_API_KEY=your_google_api_key_here

# Note: OpenAI is no longer used - all AI services now use Google Gemini
# OPENAI_API_KEY=your_openai_api_key_here (DEPRECATED)
# OPENAI_MODEL=gpt-4 (DEPRECATED)

# ===========================================
# GOOGLE SERVICES CONFIGURATION
# ===========================================
# Google Service Account Key (JSON file path or base64 encoded)
# Option 1: File path
GOOGLE_SERVICE_ACCOUNT_KEY=./google-credentials.json
# Option 2: Base64 encoded JSON (for production)
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=base64_encoded_service_account_json

# Google Custom Search Engine Configuration
GOOGLE_SEARCH_ENGINE_ID=your_custom_search_engine_id
GOOGLE_SEARCH_API_KEY=your_google_search_api_key

# Google Drive Folder ID (optional - for organizing created documents)
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
SUPABASE_URL=https://nxhsodmddjrsjgcqmzok.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Redis Cloud (use individual credentials for better reliability)
REDIS_USERNAME=default
REDIS_PASSWORD=33rF1pkEpRvWzfK9lWqnmSPV1KHSIy8Y
REDIS_HOST=redis-17337.c84.us-east-1-2.ec2.redns.redis-cloud.com
REDIS_PORT=17337
# Alternative: Redis URL format
# REDIS_URL=redis://username:password@host:port

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# Environment (development, production)
NODE_ENV=development

# Server Port
PORT=3000

# Webhook URL (for production)
WEBHOOK_URL=https://your-app-name.onrender.com

# ===========================================
# AUTONOMOUS BEHAVIOR CONFIGURATION
# ===========================================
# Enable/disable autonomous behavior
AUTONOMOUS_MODE=true

# Working hours (Tehran timezone)
WORK_START_HOUR=9
WORK_END_HOUR=18

# Proactive action interval (minutes)
PROACTIVE_INTERVAL=30

# ===========================================
# RENDER DEPLOYMENT CONFIGURATION
# ===========================================
# Render Service ID (for GitHub Actions)
RENDER_SERVICE_ID=your_render_service_id

# Render API Key (for GitHub Actions)
RENDER_API_KEY=your_render_api_key

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable Google Docs creation
FEATURE_GOOGLE_DOCS=true

# Enable web search
FEATURE_WEB_SEARCH=true

# Enable image generation
FEATURE_IMAGE_GENERATION=true

# Enable cross-bot communication
FEATURE_CROSS_BOT_COMMUNICATION=true

# Enable autonomous notifications
FEATURE_AUTONOMOUS_NOTIFICATIONS=true

# ===========================================
# LOGGING AND MONITORING
# ===========================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable performance monitoring
MONITORING_ENABLED=true